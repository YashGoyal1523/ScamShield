# ============================================================
# server/.gitignore
# Backend-specific ignores for Node.js/Express server
# ============================================================

# ---- ENVIRONMENT ----
# NEVER commit .env — contains MongoDB URI, JWT secret, API keys
.env
.env.local
.env.*.local

# ---- DEPENDENCIES ----
node_modules/
package-lock.json
yarn.lock

# ---- LOGS ----
logs/
*.log
npm-debug.log*
npm-error.log*
yarn-debug.log*
yarn-error.log*

# ---- BUILD ----
dist/
build/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- TESTING ----
coverage/
.nyc_output/

# ---- CACHE ----
.cache/
.eslintcache

# ---- TEMP ----
*.tmp
tmp/
temp/
